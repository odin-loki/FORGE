# ctest sqlite_pin: the vendored amalgamation in third_party/sqlite equals third_party/sqlite/PIN.
# Run as: cmake -DDIR=<third_party/sqlite> -P check_sqlite_pin.cmake
# PIN lines: "key=value" or "file <name> <sha256> <sha3_256>". Every `file` line must match both digests, the
# version in PIN must equal SQLITE_VERSION / SQLITE_VERSION_NUMBER in sqlite3.h, and no other source file may sit
# next to the pin unlisted.
if(NOT DEFINED DIR)
  message(FATAL_ERROR "usage: cmake -DDIR=<third_party/sqlite> -P check_sqlite_pin.cmake")
endif()
file(STRINGS "${DIR}/PIN" _lines)
set(_listed "")
set(_n 0)
foreach(l ${_lines})
  if(l MATCHES "^#" OR l STREQUAL "")
    continue()
  endif()
  if(l MATCHES "^file ([A-Za-z0-9_.]+) ([0-9a-f]+) ([0-9a-f]+)$")
    set(f ${CMAKE_MATCH_1})
    file(SHA256 "${DIR}/${f}" _got256)
    file(SHA3_256 "${DIR}/${f}" _got3)
    if(NOT _got256 STREQUAL "${CMAKE_MATCH_2}")
      message(SEND_ERROR "${f}: SHA-256 ${_got256} != PIN ${CMAKE_MATCH_2}")
    endif()
    if(NOT _got3 STREQUAL "${CMAKE_MATCH_3}")
      message(SEND_ERROR "${f}: SHA3-256 ${_got3} != PIN ${CMAKE_MATCH_3}")
    endif()
    list(APPEND _listed ${f})
    math(EXPR _n "${_n} + 1")
  elseif(l MATCHES "^([a-z_0-9]+)=(.*)$")
    set(PIN_${CMAKE_MATCH_1} "${CMAKE_MATCH_2}")
  else()
    message(SEND_ERROR "PIN: cannot parse line: ${l}")
  endif()
endforeach()
foreach(f sqlite3.c sqlite3.h sqlite3ext.h)
  if(NOT f IN_LIST _listed)
    message(SEND_ERROR "PIN does not list ${f}")
  endif()
endforeach()
file(STRINGS "${DIR}/sqlite3.h" _ver REGEX "^#define SQLITE_VERSION +\"")
file(STRINGS "${DIR}/sqlite3.h" _vnum REGEX "^#define SQLITE_VERSION_NUMBER ")
if(NOT _ver MATCHES "\"${PIN_version}\"")
  message(SEND_ERROR "sqlite3.h says ${_ver}, PIN says version=${PIN_version}")
endif()
if(NOT _vnum MATCHES " ${PIN_version_number}$")
  message(SEND_ERROR "sqlite3.h says ${_vnum}, PIN says version_number=${PIN_version_number}")
endif()
file(GLOB _present RELATIVE "${DIR}" "${DIR}/*.c" "${DIR}/*.h")
foreach(f ${_present})
  if(NOT f IN_LIST _listed)
    message(SEND_ERROR "${f} is in ${DIR} but not pinned")
  endif()
endforeach()
message(STATUS "sqlite_pin: SQLite ${PIN_version}, ${_n} files match SHA-256 and SHA3-256")
