# Compile and link one test for TARGET with zig: SRC (C++23) plus the C sources in CSRCS (|-list), which are
# compiled on their own first (zig 0.17 refuses -std=c++NN on a C input). INCS and LIBS are |-lists.
string(REPLACE "|" ";" _inc "${INCS}")
string(REPLACE "|" ";" _libs "${LIBS}")
string(REPLACE "|" ";" _csrcs "${CSRCS}")
get_filename_component(_dir "${OUT}" DIRECTORY)
file(MAKE_DIRECTORY "${_dir}")
set(_objs)
foreach(c ${_csrcs})
  get_filename_component(n "${c}" NAME_WE)
  execute_process(COMMAND "${ZIG}" cc -target ${TARGET} -O1 -c ${_inc} "${c}" -o "${OUT}.${n}.o" RESULT_VARIABLE rc)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "${c} failed for ${TARGET}")
  endif()
  list(APPEND _objs "${OUT}.${n}.o")
endforeach()
execute_process(COMMAND "${ZIG}" c++ -target ${TARGET} -std=c++23 -O1 ${_inc} "${SRC}" ${_objs} ${_libs} -o "${OUT}" RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "${SRC} failed for ${TARGET}")
endif()
