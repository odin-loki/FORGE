# Gemma-2 text decoder (gemma-2-2b / 9b / 27b). On top of the first generation (gemma.fbp):
#   - a norm before AND after each sub-block: x + post_norm(attn(pre_norm(x))), x + post_norm(mlp(pre_norm(x))),
#   - attention scores scaled by query_pre_attn_scalar^-0.5 and soft-capped, cap * tanh(score / cap), before the mask
#     (attention_bias with a zero bias: the plain attention op has no soft-cap),
#   - alternating local / global attention: layers with mod(l + 1, pattern) != 0 see only the last `window` keys
#     (pattern 2: the even layers), the others the whole context,
#   - soft-capped output logits.
# attention_bias reads f32 keys and values, so this template needs the f32 KV cache (the default).
# Double-brace placeholders are substituted by `forge import` from config.json.
blueprint "decoder-lm" opset 3

params {
  d_model: {{hidden_size}}  n_layers: {{num_hidden_layers}}  n_heads: {{num_attention_heads}}
  n_kv: {{num_key_value_heads}}  head_dim: {{head_dim}}  ffn: {{intermediate_size}}
  vocab: {{vocab_size}}  eps: {{rms_norm_eps}}
  attn_scale: {{attn_scale}}  attn_softcap: {{attn_softcap}}  final_softcap: {{final_softcap}}
  window: {{sliding_window}}  pattern: {{sliding_window_pattern}}
  rope: { base: {{rope_theta}} }
}

state kv[n_layers] : kv_cache(heads: n_kv, dim: head_dim)

input tokens    : f32[seq]
input positions : f32[seq]

op geglu(h, w_gate, w_up, w_down) { return linear({{act}}(linear(h, w_gate)) * linear(h, w_up), w_down) }

graph {
  x = embed(W.tok_emb, tokens) * sqrt(d_model)
  repeat l in 0..n_layers {
    local = min(1, mod(l + 1, pattern))
    h = rms_norm(x, W.layer[l].attn_norm, eps)
    q = rope(heads(linear(h, W.layer[l].wq), n_heads, head_dim), positions, base: rope.base, neox: 1)
    k = rope(heads(linear(h, W.layer[l].wk), n_kv, head_dim), positions, base: rope.base, neox: 1)
    v = heads(linear(h, W.layer[l].wv), n_kv, head_dim)
    kk, vv = kv[l].append(k, v)
    a = attention_bias(q, kk, vv, scalar(0), causal: true, groups: n_heads / n_kv, scale: attn_scale, window: window * local, softcap: attn_softcap)
    x = x + rms_norm(linear(merge(a, n_heads * head_dim), W.layer[l].wo), W.layer[l].attn_post_norm, eps)
    m = geglu(rms_norm(x, W.layer[l].ffn_norm, eps), W.layer[l].w_gate, W.layer[l].w_up, W.layer[l].w_down)
    x = x + rms_norm(m, W.layer[l].ffn_post_norm, eps)
  }
  lg = linear(rms_norm(last(x, seq), W.out_norm, eps), W.lm_head)
  logits = {{logits_expr}}
}

output logits : f32[1, vocab]
session generative_sequence
