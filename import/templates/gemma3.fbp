# Gemma-3 text decoder (gemma-3-1b-it and the language model of the multimodal 4b / 12b / 27b checkpoints; the
# vision tower is not imported). Gemma-2's layout (gemma2.fbp) with
#   - RMS-normed queries and keys (QK-norm, weights stored as 1 + w) instead of attention soft-capping,
#   - a sliding-window pattern: layers with mod(l + 1, pattern) != 0 are local (last `window` keys, RoPE base
#     rope.local), every pattern-th layer is global (whole context, RoPE base rope.base),
#   - no soft-capping unless the config sets it.
# Double-brace placeholders are substituted by `forge import` from config.json (text_config).
blueprint "decoder-lm" opset 1

params {
  d_model: {{hidden_size}}  n_layers: {{num_hidden_layers}}  n_heads: {{num_attention_heads}}
  n_kv: {{num_key_value_heads}}  head_dim: {{head_dim}}  ffn: {{intermediate_size}}
  vocab: {{vocab_size}}  eps: {{rms_norm_eps}}
  attn_scale: {{attn_scale}}  final_softcap: {{final_softcap}}
  window: {{sliding_window}}  pattern: {{sliding_window_pattern}}
  rope: { base: {{rope_theta}}  local: {{rope_local_base_freq}} }
}

state kv[n_layers] : kv_cache(heads: n_kv, dim: head_dim)

input tokens    : f32[seq]
input positions : f32[seq]

op geglu(h, w_gate, w_up, w_down) { return linear({{act}}(linear(h, w_gate)) * linear(h, w_up), w_down) }

graph {
  x = embed(W.tok_emb, tokens) * sqrt(d_model)
  repeat l in 0..n_layers {
    local = min(1, mod(l + 1, pattern))
    base = rope.base + (rope.local - rope.base) * local
    h = rms_norm(x, W.layer[l].attn_norm, eps)
    q = rms_norm(heads(linear(h, W.layer[l].wq), n_heads, head_dim), W.layer[l].q_norm, eps)
    k = rms_norm(heads(linear(h, W.layer[l].wk), n_kv, head_dim), W.layer[l].k_norm, eps)
    q = rope(q, positions, base: base, neox: 1)
    k = rope(k, positions, base: base, neox: 1)
    v = heads(linear(h, W.layer[l].wv), n_kv, head_dim)
    kk, vv = kv[l].append(k, v)
    a = attention(q, kk, vv, causal: true, groups: n_heads / n_kv, scale: attn_scale, window: window * local)
    x = x + rms_norm(linear(merge(a, n_heads * head_dim), W.layer[l].wo), W.layer[l].attn_post_norm, eps)
    m = geglu(rms_norm(x, W.layer[l].ffn_norm, eps), W.layer[l].w_gate, W.layer[l].w_up, W.layer[l].w_down)
    x = x + rms_norm(m, W.layer[l].ffn_post_norm, eps)
  }
  lg = linear(rms_norm(last(x, seq), W.out_norm, eps), W.lm_head)
  logits = {{logits_expr}}
}

output logits : f32[1, vocab]
session generative_sequence
