# forge import optimises float Hugging Face checkpoints by default (forge::compress `optimise`), and
# --no-optimise imports them as stored. Run: cmake -DFORGE=<forge> -DHF=<hf dir> -DWORK=<dir> -P compress_import.cmake
file(MAKE_DIRECTORY ${WORK})
execute_process(COMMAND ${CMAKE_COMMAND} -E env --unset=FORGE_OPTIMISE ${FORGE} import ${HF} -o ${WORK}/opt.fpk --nsamples 4 --seqlen 32 --probes 2 --probe-len 32
                RESULT_VARIABLE r1 OUTPUT_VARIABLE o1 ERROR_VARIABLE e1)
if(NOT r1 EQUAL 0)
  message(FATAL_ERROR "default import failed: ${o1}${e1}")
endif()
if(NOT e1 MATCHES "optimising")
  message(FATAL_ERROR "default import did not optimise: ${e1}")
endif()
execute_process(COMMAND ${FORGE} inspect ${WORK}/opt.fpk --tensors OUTPUT_VARIABLE ins)
if(NOT ins MATCHES "q[0-9]_" AND NOT ins MATCHES "q8_0")
  message(FATAL_ERROR "optimised model has no quantised tensors:\n${ins}")
endif()
execute_process(COMMAND ${FORGE} run ${WORK}/opt.fpk --tokens 1,2,3 -n 4 RESULT_VARIABLE r2 OUTPUT_VARIABLE o2 ERROR_VARIABLE e2)
if(NOT r2 EQUAL 0)
  message(FATAL_ERROR "optimised model does not run: ${o2}${e2}")
endif()
execute_process(COMMAND ${FORGE} import ${HF} -o ${WORK}/plain.fpk --no-optimise RESULT_VARIABLE r3 ERROR_VARIABLE e3)
if(NOT r3 EQUAL 0 OR e3 MATCHES "optimising")
  message(FATAL_ERROR "--no-optimise: ${e3}")
endif()
message(STATUS "compress_import: default import optimised, --no-optimise kept as stored")
