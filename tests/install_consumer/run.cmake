# install_consumer test driver (cmake -P): installs the FORGE build tree FORGE_BUILD_DIR into a scratch prefix under
# FORGE_WORK_DIR, checks the package files, then configures, builds, installs and runs the consumer project in this
# directory against that prefix. The FORGE_* variables come from the add_test() call in the top-level CMakeLists.txt.
cmake_minimum_required(VERSION 3.25)
foreach(v FORGE_BUILD_DIR FORGE_SOURCE_DIR FORGE_WORK_DIR)
  if(NOT ${v})
    message(FATAL_ERROR "install_consumer: ${v} is not set")
  endif()
endforeach()

function(run what)
  execute_process(COMMAND ${ARGN} RESULT_VARIABLE rc)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "install_consumer: ${what} failed (${rc})")
  endif()
endfunction()

# Install directories relative to the prefix (GNUInstallDirs defaults unless the FORGE build changed them).
foreach(d BINDIR=bin INCLUDEDIR=include TEMPLATEDIR=share/forge/templates)
  string(REGEX MATCH "^([A-Z]+)=(.*)$" _ "${d}")
  if(NOT FORGE_${CMAKE_MATCH_1} OR IS_ABSOLUTE "${FORGE_${CMAKE_MATCH_1}}")
    set(FORGE_${CMAKE_MATCH_1} "${CMAKE_MATCH_2}")
  endif()
endforeach()
set(exe "")
if(CMAKE_HOST_WIN32)
  set(exe .exe)
endif()
set(prefix "${FORGE_WORK_DIR}/prefix")
set(build "${FORGE_WORK_DIR}/build")
file(REMOVE_RECURSE "${FORGE_WORK_DIR}")
set(cfg "")
if(FORGE_CONFIG)
  set(cfg --config ${FORGE_CONFIG})
endif()

# 1. Install.
run("install" ${CMAKE_COMMAND} --install "${FORGE_BUILD_DIR}" --prefix "${prefix}" ${cfg})

# 2. The files a consumer needs are there, and the package files name neither the source nor the build tree.
file(GLOB_RECURSE pkg_files "${prefix}/*/forgeConfig.cmake" "${prefix}/*/forgeConfigVersion.cmake" "${prefix}/*/forgeTargets*.cmake" "${prefix}/*/forge.pc")
list(LENGTH pkg_files n)
if(n LESS 4)
  message(FATAL_ERROR "install_consumer: expected forgeConfig.cmake, forgeConfigVersion.cmake, forgeTargets*.cmake and forge.pc under ${prefix}, found: ${pkg_files}")
endif()
foreach(f ${pkg_files})
  file(READ "${f}" text)
  foreach(leak "${FORGE_SOURCE_DIR}" "${FORGE_BUILD_DIR}")
    string(FIND "${text}" "${leak}" at)
    if(NOT at EQUAL -1)
      message(FATAL_ERROR "install_consumer: ${f} contains the path ${leak}")
    endif()
  endforeach()
endforeach()
set(inc "${FORGE_INCLUDEDIR}")
foreach(f ${inc}/forge.h ${inc}/forge/os/os.hpp ${inc}/forge/loadbalancer ${inc}/forge/script ${inc}/forge/security
          ${inc}/forge/ops/ops.gen.hpp ${inc}/forge/gpu/gpu_images.gen.hpp ${inc}/forge/third_party/monocypher/monocypher.h
          ${inc}/forge/third_party/level-zero/ze_api.h ${FORGE_TEMPLATEDIR}/llama.fbp)
  if(NOT EXISTS "${prefix}/${f}")
    message(FATAL_ERROR "install_consumer: ${prefix}/${f} was not installed")
  endif()
endforeach()

# 3. forge.pc, when pkg-config is available.
find_program(PKG_CONFIG NAMES pkg-config pkgconf)
if(PKG_CONFIG)
  list(FILTER pkg_files INCLUDE REGEX "forge\\.pc$")
  list(GET pkg_files 0 pc)
  get_filename_component(pcdir "${pc}" DIRECTORY)
  set(ENV{PKG_CONFIG_PATH} "${pcdir}")
  execute_process(COMMAND ${PKG_CONFIG} --cflags --libs forge OUTPUT_VARIABLE pc_out RESULT_VARIABLE rc OUTPUT_STRIP_TRAILING_WHITESPACE)
  if(NOT rc EQUAL 0 OR NOT pc_out MATCHES "-lforge" OR NOT pc_out MATCHES "-I")
    message(FATAL_ERROR "install_consumer: pkg-config --cflags --libs forge failed (${rc}): ${pc_out}")
  endif()
  message(STATUS "pkg-config forge: ${pc_out}")
else()
  message(STATUS "pkg-config not found: forge.pc not checked")
endif()

# 4. Configure, build and install the consumer with the toolchain FORGE was built with.
set(args -S "${CMAKE_CURRENT_LIST_DIR}" -B "${build}" "-DCMAKE_PREFIX_PATH=${prefix}" "-DCMAKE_INSTALL_PREFIX=${prefix}" "-DCONSUMER_BINDIR=${FORGE_BINDIR}")
if(FORGE_GENERATOR)
  list(APPEND args -G "${FORGE_GENERATOR}")
endif()
if(FORGE_GENERATOR_PLATFORM)
  list(APPEND args -A "${FORGE_GENERATOR_PLATFORM}")
endif()
if(FORGE_GENERATOR_TOOLSET)
  list(APPEND args -T "${FORGE_GENERATOR_TOOLSET}")
endif()
if(FORGE_CONFIG)
  list(APPEND args "-DCMAKE_BUILD_TYPE=${FORGE_CONFIG}")
endif()
foreach(v MAKE_PROGRAM C_COMPILER CXX_COMPILER TOOLCHAIN_FILE OSX_ARCHITECTURES)
  if(FORGE_${v})
    list(APPEND args "-DCMAKE_${v}=${FORGE_${v}}")
  endif()
endforeach()
run("consumer configure" ${CMAKE_COMMAND} ${args})
run("consumer build" ${CMAKE_COMMAND} --build "${build}" ${cfg})
run("consumer install" ${CMAKE_COMMAND} --install "${build}" ${cfg})

# 5. Run both from the prefix's bin directory. No FORGE_TEMPLATES: consumer_cpp must find the installed templates by itself.
unset(ENV{FORGE_TEMPLATES})
run("consumer_c" "${prefix}/${FORGE_BINDIR}/consumer_c${exe}")
run("consumer_cpp" "${prefix}/${FORGE_BINDIR}/consumer_cpp${exe}" "${prefix}/${FORGE_TEMPLATEDIR}")
message(STATUS "install_consumer: ok")
