  deps = gcc
  command = ${LAUNCHER}${CODE_CHECK}/workspace/opt/llvm23/bin/clang++ $DEFINES $INCLUDES $FLAGS -MD -MT $out -MF $DEP_FILE @$DYNDEP_MODULE_MAP_FILE -o $out -c $in
  description = Building CXX object $out


