# Rule for generating CXX dependencies.

rule CXX_SCAN__test_pool_Release
  depfile = $DEP_FILE
  command = "/workspace/opt/llvm23/bin/clang-scan-deps" -format=p1689 -- /workspace/opt/llvm23/bin/clang++ $DEFINES $INCLUDES $FLAGS -x c++ -c -o $OBJ_FILE -resource-dir "/workspace/opt/llvm23/lib/clang/23" -MT $DYNDEP_INTERMEDIATE_FILE -MD -MF $DEP_FILE $in > $DYNDEP_INTERMEDIATE_FILE.tmp && mv $DYNDEP_INTERMEDIATE_FILE.tmp $DYNDEP_INTERMEDIATE_FILE
  description = Scanning $in for CXX dependencies


