#############################################
# Rule for running custom commands.

rule CUSTOM_COMMAND
  command = $COMMAND
  description = $DESC


#############################################
# Rule for re-running cmake.

rule RERUN_CMAKE
  command = /home/box/.local/lib/python3.13/site-packages/cmake/data/bin/cmake --regenerate-during-build -S/workspace/FORGE-q35 -B/workspace/FORGE-q35/build-t
  description = Re-running CMake...
  generator = 1


#############################################
# Rule for re-checking globbed directories.

rule VERIFY_GLOBS
  command = /home/box/.local/lib/python3.13/site-packages/cmake/data/bin/cmake -P /workspace/FORGE-q35/build-t/CMakeFiles/VerifyGlobs.cmake
  description = Re-checking globbed directories...
  generator = 1


#############################################
# Rule for cleaning all built files.

rule CLEAN
  command = /home/box/.local/bin/ninja $FILE_ARG -t clean $TARGETS
  description = Cleaning all built files...


#############################################
# Rule for printing all primary targets available.

rule HELP
  command = /home/box/.local/bin/ninja -t targets
  description = All primary targets available:

